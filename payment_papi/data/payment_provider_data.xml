<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_papi" model="payment.provider">
        <field name="name">Papi</field>
        <field name="code">papi</field>
        <field name="image_128" type="bytes" file="payment_papi/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_papi"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="allow_tokenization">False</field>
        <field name="available_currency_ids" eval="[Command.set([ref('base.MGA')])]"/>
        <field name="available_country_ids" eval="[Command.set([ref('base.mg')])]"/>
        <field name="pre_msg"><![CDATA[
<p>You will be redirected to the Papi website to pay with MVola, Orange Money, Airtel Money or a card.</p>]]>
        </field>
    </record>

</odoo>
