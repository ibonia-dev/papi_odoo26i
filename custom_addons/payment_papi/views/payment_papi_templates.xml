<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <form t-att-action="api_url" method="get"/>
    </template>

    <template id="method_form" inherit_id="payment.method_form">
        <!-- Show the Papi logo and a short subtitle instead of the plain method name. -->
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="attributes">
            <attribute name="t-if">pm_sudo.code != 'papi'</attribute>
        </xpath>
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <label t-else=""
                   class="o_payment_option_label o_payment_papi_label d-flex flex-column gap-1 mb-0"
                   t-attf-for="o_payment_method_{{pm_sudo.id}}"
            >
                <img src="/payment_papi/static/img/papi_logo.png"
                     alt="Papi"
                     class="o_payment_papi_logo"
                />
                <span class="small text-600">Mobile Money &amp; bank card</span>
            </label>
        </xpath>
        <!-- Papi stays listed below its minimum amount: say why it cannot be used instead of
             making the customer guess. The payment itself is refused by the transaction. -->
        <xpath expr="//div[@name='o_payment_inline_form']" position="before">
            <div t-if="provider_sudo.code == 'papi' and amount and amount &lt; provider_sudo.papi_minimum_amount"
                 class="alert alert-warning mb-0 py-2 small"
                 role="alert"
                 name="papi_minimum_amount_warning"
            >
                <strong>Papi cannot be used for this amount.</strong>
                The minimum for a Papi payment is
                <strong t-out="provider_sudo.papi_minimum_amount"
                        t-options="{'widget': 'monetary', 'display_currency': currency}"
                />, and this payment is only
                <span t-out="amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>.
                Increase the amount, or choose another payment method.
            </div>
        </xpath>
        <!-- The Papi logo is already displayed above: hide "Secured by". -->
        <xpath expr="//t[@t-set='hide_secured_by']" position="attributes">
            <attribute name="t-value" separator=" " add="or provider_sudo.code == 'papi'"/>
        </xpath>
    </template>

    <template id="form_logo" inherit_id="payment.form_logo">
        <!-- Odoo shrinks the logo of a payment method to 45x30 px when storing it, which makes it blurry
             on high-density screens: display the brands of Papi from the full-size files instead. -->
        <xpath expr="//span[@t-field]" position="attributes">
            <attribute name="t-if">not logo_pm_sudo.code.startswith('papi_')</attribute>
        </xpath>
        <xpath expr="//span[@t-field]" position="after">
            <span t-else=""
                  class="position-relative d-block rounded overflow-hidden z-1 shadow-sm"
                  t-att-title="logo_pm_sudo.name"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top"
                  data-bs-delay="0"
            >
                <img t-att-src="'/payment/static/img/visa.png' if logo_pm_sudo.code == 'papi_visa'
                                else '/payment_papi/static/img/%s.png' % logo_pm_sudo.code[5:]"
                     t-att-alt="logo_pm_sudo.name"
                     width="45"
                     height="30"
                     class="img img-fluid"
                />
            </span>
        </xpath>
    </template>

</odoo>
