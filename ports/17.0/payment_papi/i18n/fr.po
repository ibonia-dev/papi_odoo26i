#: code:addons/payment_papi/models/payment_provider.py:0
#, python-format
msgid "The communication with the API failed. Please try again later."
msgstr "La communication avec l'API a échoué. Veuillez réessayer plus tard."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_provider.py:0
#, python-format
msgid "The connection to Papi succeeded: the API key is valid."
msgstr "Connexion à Papi réussie : la clé API est valide."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid ""
"The currency returned by Papi (%(received)s) does not match the transaction "
"(%(expected)s)."
msgstr ""
"La devise renvoyée par Papi (%(received)s) ne correspond pas à la "
"transaction (%(expected)s)."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/wizards/papi_backend_pay_wizard.py:0
#, python-format
msgid "The document to pay does not exist anymore."
msgstr "Le document à payer n'existe plus."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_error_code
msgid ""
"The last error code returned by the Papi API, or detected by Odoo (for "
"instance 'inconsistent_data' or 'paid_after_cancel'). Used to diagnose "
"blocked transactions."
msgstr ""
"Le dernier code d'erreur renvoyé par l'API Papi ou détecté par Odoo (par "
"exemple « inconsistent_data » ou « paid_after_cancel »). Sert à "
"diagnostiquer les transactions bloquées."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_message
msgid ""
"The last failure reason reported by Papi, or the last error detected by Odoo."
msgstr ""
"Le dernier motif d'échec indiqué par Papi, ou la dernière erreur détectée "
"par Odoo."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_provider__papi_minimum_amount_warning
msgid ""
"The message shown to the customer when the amount is below the minimum of "
"Papi."
msgstr ""
"Le message affiché au client lorsque le montant est inférieur au minimum de "
"Papi."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid "The minimum amount for a Papi payment is %s MGA."
msgstr "Le montant minimum pour un paiement Papi est de %s MGA."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_provider__papi_minimum_amount
msgid "The minimum amount, in MGA, that Papi accepts for a payment."
msgstr "Le montant minimum, en MGA, qu'accepte Papi pour un paiement."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_provider.py:0
#: code:addons/payment_papi/wizards/papi_backend_pay_wizard.py:0
#, python-format
msgid ""
"The minimum for a Papi payment is %(minimum)s MGA. Increase the amount, or "
"choose another payment method."
msgstr ""
"Le minimum pour un paiement Papi est de %(minimum)s MGA. Augmentez le "
"montant ou choisissez un autre moyen de paiement."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_provider__papi_shop_name
msgid ""
"The name of the Papi shop linked to the API key. Informational only: the "
"shop is determined by the API key."
msgstr ""
"Le nom de la boutique Papi liée à la clé API. À titre informatif : la "
"boutique est déterminée par la clé API."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid "The notification token returned by Papi does not match the transaction."
msgstr ""
"Le jeton de notification renvoyé par Papi ne correspond pas à la transaction."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_papi_backend_pay_wizard__payer_phone
msgid ""
"The number of the customer's Mobile Money account, used to prefill the Papi "
"page. It is not saved on the customer."
msgstr ""
"Le numéro du compte Mobile Money du client, utilisé pour préremplir la page "
"Papi. Il n'est pas enregistré sur la fiche du client."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid "The reference returned by Papi does not match the transaction."
msgstr "La référence renvoyée par Papi ne correspond pas à la transaction."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_provider__papi_webhook_secret
msgid ""
"The secret used to verify the X-Papi-Signature header of notifications. It "
"starts with 'pwhsec_'."
msgstr ""
"Le secret utilisé pour vérifier l'en-tête X-Papi-Signature des "
"notifications. Il commence par 'pwhsec_'."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr "Le code technique de ce fournisseur de paiement."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_notification_token
msgid ""
"The token returned by Papi when the payment link was created. Papi sends it "
"back in every notification."
msgstr ""
"Le jeton renvoyé par Papi à la création du lien de paiement. Papi le renvoie "
"dans chaque notification."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/wizards/papi_backend_pay_wizard.py:0
#, python-format
msgid "This document cannot be paid at the moment."
msgstr "Ce document ne peut pas être payé pour le moment."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid ""
"Unknown status received from Papi (link: %(link)s, payment: %(payment)s)."
msgstr "Statut inconnu reçu de Papi (lien : %(link)s, paiement : %(payment)s)."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid "Unrecognized status received from Papi: %s."
msgstr "Statut non reconnu reçu de Papi : %s."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_last_sync_date
msgid "When Odoo last read the status of this transaction from the Papi API."
msgstr ""
"Date à laquelle Odoo a lu pour la dernière fois le statut de cette "
"transaction via l'API Papi."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_last_notification_date
msgid ""
"When Odoo last received a signed notification from Papi for this transaction."
msgstr ""
"Date à laquelle Odoo a reçu pour la dernière fois une notification signée de "
"Papi pour cette transaction."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_payment_transaction__papi_backend_origin
msgid ""
"Whether an operator created the transaction with the \"Pay with Papi\" "
"button of an invoice or a sales order, instead of the customer from the "
"checkout or the portal."
msgstr ""
"Indique si un opérateur a créé la transaction avec le bouton « Pay with "
"Papi » d'une facture ou d'une commande, plutôt que le client depuis le "
"paiement en ligne ou le portail."

#. module: payment_papi
#: model:ir.model.fields,help:payment_papi.field_account_bank_statement_line__papi_backend_payment_available
#: model:ir.model.fields,help:payment_papi.field_account_move__papi_backend_payment_available
#: model:ir.model.fields,help:payment_papi.field_account_payment__papi_backend_payment_available
#: model:ir.model.fields,help:payment_papi.field_papi_backend_pay_mixin__papi_backend_payment_available
msgid "Whether the document can be paid with Papi from the back-office."
msgstr "Indique si le document peut être payé avec Papi depuis le back-office."

#. module: payment_papi
#: model_terms:payment.provider,pre_msg:payment_papi.payment_provider_papi
msgid ""
"You will be redirected to the Papi website to pay with MVola, Orange Money, "
"Airtel Money or a card."
msgstr ""
"Vous allez être redirigé vers le site Papi pour payer par MVola, Orange "
"Money, Airtel Money ou carte."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid ""
"Your payment could not be verified. Please contact us with the reference %s."
msgstr ""
"Votre paiement n'a pas pu être vérifié. Veuillez nous contacter en indiquant "
"la référence %s."

#. module: payment_papi
#: model_terms:payment.provider,auth_msg:payment_papi.payment_provider_papi
msgid "Your payment has been authorized."
msgstr "Votre paiement a été autorisé."

#. module: payment_papi
#: model_terms:payment.provider,cancel_msg:payment_papi.payment_provider_papi
msgid "Your payment has been cancelled."
msgstr "Votre paiement a été annulé."

#. module: payment_papi
#: model_terms:payment.provider,pending_msg:payment_papi.payment_provider_papi
msgid ""
"Your payment has been successfully processed but is waiting for approval."
msgstr "Votre paiement a bien été traité mais est en attente de validation."

#. module: payment_papi
#: model_terms:payment.provider,done_msg:payment_papi.payment_provider_papi
msgid "Your payment has been successfully processed."
msgstr "Votre paiement a bien été traité."

#. module: payment_papi
#. odoo-python
#: code:addons/payment_papi/models/payment_transaction.py:0
#, python-format
msgid "Your payment was refused by Papi. Please try again."
msgstr "Votre paiement a été refusé par Papi. Veuillez réessayer."

