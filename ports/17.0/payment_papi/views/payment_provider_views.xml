<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Papi Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'papi'" name="papi_credentials">
                    <div class="alert alert-info" role="note" colspan="2" name="papi_credentials_help">
                        <strong>Where to find your Papi credentials</strong>
                        <ol class="mb-0 mt-1">
                            <li>Log in to the <a href="https://dashboard.papi.mg" target="_blank">Papi dashboard</a>.</li>
                            <li><strong>API Key</strong>: click your avatar, open <em>Shops</em>, select your shop, then open the <em>Developer</em> tab. One API key identifies one shop.</li>
                            <li><strong>Notification Signing Secret</strong> (starts with <code>pwhsec_</code>): in the same <em>Developer</em> tab, copy the notification signing secret (X-Papi-Signature).</li>
                            <li>Paste both values below, then click <em>Test the Connection</em>.</li>
                        </ol>
                        <a href="https://docs.papi.mg/docs/developper-guide/integration-guide/" target="_blank">Papi integration guide</a>
                    </div>
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="state != 'test'">
                        Papi has no sandbox. In test mode, payments are flagged as tests in the Papi
                        dashboard but <strong>Mobile Money payments are real and debit the payer</strong>.
                        Use the Papi shop "Test Mode" with the test card to test without moving money.
                    </div>
                    <field name="papi_shop_name" placeholder="e.g. My Shop"/>
                    <field name="papi_api_key"
                           string="API Key"
                           required="code == 'papi' and state != 'disabled'"
                           password="True"/>
                    <field name="papi_webhook_secret"
                           string="Notification Signing Secret"
                           required="code == 'papi' and state != 'disabled'"
                           placeholder="pwhsec_..."
                           password="True"/>
                    <field name="papi_link_validity"/>
                    <div colspan="2">
                        <button name="action_papi_test_connection"
                                type="object"
                                string="Test the Connection"
                                class="btn-secondary"
                                icon="fa-plug"
                                invisible="state == 'disabled'"/>
                    </div>
                </group>
            </group>
            <!-- Papi has no sandbox: the test mode is not offered for now, see `TEST_MODE_ENABLED`
                 in const.py. Remove these two blocks to show the core selection again. -->
            <xpath expr="//group[@name='payment_state']/field[@name='state']" position="attributes">
                <attribute name="invisible">code == 'papi'</attribute>
            </xpath>
            <xpath expr="//group[@name='payment_state']/field[@name='state']" position="after">
                <field name="papi_state" widget="radio" invisible="code != 'papi'"/>
            </xpath>
        </field>
    </record>

</odoo>
