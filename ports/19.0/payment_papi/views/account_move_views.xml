<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_papi" model="ir.ui.view">
        <field name="name">account.move.form.papi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="papi_backend_payment_available" invisible="1"/>
                <button name="action_papi_pay_backend"
                        type="object"
                        string="Pay with Papi"
                        class="btn-secondary"
                        invisible="not papi_backend_payment_available"
                        groups="account.group_account_invoice"/>
            </header>
        </field>
    </record>

</odoo>
